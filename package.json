{
  "name": "@u7er/lens-rowcraft",
  "version": "0.3.3",
  "description": "Configurable two-line workload rows with a visual layout editor and saved per-view layouts.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "author": "Pavel Manakov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/u7er/lens-rowcraft.git"
  },
  "homepage": "https://github.com/u7er/lens-rowcraft#readme",
  "bugs": {
    "url": "https://github.com/u7er/lens-rowcraft/issues"
  },
  "keywords": [
    "lens-extension"
  ],
  "type": "commonjs",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "assets",
    "NOTICE",
    "DEVELOPMENT.md",
    "RELEASING.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "lensExtension": {
    "icon": "assets/icon.svg",
    "banner": "assets/banner.svg"
  },
  "scripts": {
    "build": "lens-types-check && lens-extension-dependencies-check && lens-package-build --entry-point ./src/index.ts",
    "preview": "node scripts/build-preview.mjs",
    "screenshot": "npm run preview && node scripts/capture-preview.mjs",
    "test:browser": "node tests/browser-check.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run test:browser && npm run build",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "lens-extension-publish-check"
  },
  "dependencies": {
    "@k8slens/feature-core": "^7.5.5",
    "@k8slens/injectable": "^26.4.0",
    "@k8slens/modal-components": "^1.3.0",
    "@k8slens/modal-contracts": "^1.0.4",
    "@k8slens/persistable-contracts": "^1.0.6",
    "@k8slens/status-bar-contracts": "^1.0.4",
    "@k8slens/stylesheet-contracts": "^1.0.2",
    "@k8slens/use-inject": "^1.0.4",
    "mobx": "^6.15.0",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@k8slens/package-build": "^3.4.0",
    "@k8slens/typescript": "^8.0.0",
    "@tanstack/virtual-core": "3.19.11",
    "@types/react": "^19.2.0",
    "esbuild": "^0.25.12",
    "jsdom": "^27.0.0",
    "playwright-core": "^1.65.0",
    "react-dom": "^19.2.0"
  }
}
